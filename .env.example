# === Database ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoconnect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autoconnect?schema=public"

# === API ===
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# === Web ===
# ATENÇÃO: o Next NÃO lê este .env da raiz — o app web lê apps/web/.env.
# E as NEXT_PUBLIC_* são embutidas no bundle durante o `next build`, não lidas
# em runtime: se mudarem, é preciso rebuildar (em produção, alterar a variável
# na plataforma sem novo build não tem efeito, e o app cai no fallback abaixo).
# Sem o sufixo /api/v1 — o código acrescenta.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Upload de imagens (veículos e foto de perfil) — vai direto do navegador para
# a Cloudinary; o backend só recebe a URL resultante. O preset precisa estar
# marcado como "unsigned" no painel da Cloudinary, senão o upload é recusado.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# === Google OAuth ===
# Crie em https://console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"
WEB_URL="http://localhost:3000"

# === Redis (BullMQ) ===
REDIS_URL="redis://localhost:6379"

# === Storage ===
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="vehicle-images"

# === Email ===
# Opção 1: Resend — use onboarding@resend.dev para testes (sem domínio próprio)
RESEND_API_KEY=""
EMAIL_FROM="AutoConnect <onboarding@resend.dev>"
# Opção 2: Gmail — gere em myaccount.google.com > Segurança > Senhas de app
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# === Observability ===
SENTRY_DSN=""
LOG_LEVEL="info"

# ── Documentos com efeito jurídico (contrato assinado, identidade) ──────────
# Bucket PRIVADO e separado do de fotos de veículo. Sem estas duas primeiras
# variáveis o contrato continua sendo emitido e regerado sob demanda, apenas
# não fica arquivado.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DOCUMENTS_BUCKET="documentos"

# ── Consulta veicular (Fase 3) ─────────────────────────────────────────────
# Sem valor: nenhuma consulta acontece e a API diz isso em voz alta, em vez de
# devolver "nada encontrado" — que viraria selo de procedência afirmando carro
# limpo com base em consulta que nunca ocorreu.
# `simulado` exercita o caminho completo sem custo; é ignorado em produção.
CONSULTA_FORNECEDOR=""

# ── Assinatura eletrônica externa (Fase 3) ─────────────────────────────────
# Sem valor: a opção "Enviar para assinatura eletrônica" some da tela e a API
# responde 503 — os contratos seguem assinados pelo registro interno.
# `simulado` roda em memória (nenhum e-mail sai) e é ignorado em produção.
# `clicksign` usa a API 3.0 e exige também as duas CLICKSIGN_* abaixo.
ASSINATURA_FORNECEDOR=""
# Segredo do HMAC do webhook (Content-Hmac: sha256=<hex>). Obrigatório para
# qualquer provedor: sem ele a assinatura externa fica desligada. Na Clicksign,
# é o "secret" exibido ao cadastrar o webhook apontando para
#   <API>/api/v1/webhooks/assinatura
ASSINATURA_WEBHOOK_SECRET=""
# Token de API da Clicksign (painel → Configurações → API). Vai cru no
# cabeçalho Authorization; nunca aparece em log nem em mensagem de erro.
CLICKSIGN_ACCESS_TOKEN=""
# Base da API, SEM /api/v3 e em https: https://sandbox.clicksign.com para
# homologação, https://app.clicksign.com em produção. Sandbox não tem validade
# jurídica. Faltando token ou URL, a assinatura externa fica desligada.
CLICKSIGN_API_URL=""
