  /// Última posição do rodízio das lojas em que este usuário é o ponteiro.
  rodizioDeLeads             TenantCrmSettings[]       @relation("RodizioUltimoUsuario")
  /// Os aparelhos em que o usuário ativou notificação push — ver o fim do arquivo.
  pushSubscriptions          PushSubscription[]
  /// Lançamentos que este usuário criou e meses que ele fechou.
