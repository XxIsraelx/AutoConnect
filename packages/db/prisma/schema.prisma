// AutoConnect — Prisma schema
// Espelha schema.sql (mesma fonte de verdade)
// Multi-tenant: shared schema + tenant_id + RLS (configurado via SQL)
//
// Observação: campos GEOGRAPHY (PostGIS) e TSVECTOR são gerenciados pelo SQL
// (não pelo Prisma). Estão marcados como Unsupported para preservar a coluna.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext, pg_trgm, postgis]
}

// ============ ENUMS ============

enum UserRole {
  super_admin
  tenant_admin
  manager
  salesperson
  customer
}

enum UserStatus {
  active
  invited
  suspended
  deleted
}

enum PresenceStatus {
  online
  busy
  away
  offline
}

enum VehicleCondition {
  new
  used
  semi_new
  demo
}

enum VehicleStatus {
  available
  reserved
  sold
  in_maintenance
  archived
}

/// Estado do **anúncio**, que é diferente do estado do **estoque**.
///
/// `VehicleStatus` responde "a loja ainda tem este carro?"; `ListingStatus`
/// responde "este carro está na vitrine?". Um carro disponível pode estar em
/// rascunho (sem foto, sem preço conferido) e um carro despublicado continua
/// no estoque, contando dias de giro e aparecendo em custo e margem.
///
/// Três estados, e não `published_at` nulo/não-nulo, porque o nulo não
/// distingue "nunca foi ao ar" de "foi tirado do ar" — e apagar a data para
/// despublicar perderia quando o anúncio estreou, que é o que a lista de
/// estoque usa para contar dias.
enum ListingStatus {
  draft
  published
  unpublished
}

/// De onde vieram as coordenadas da filial — e, por consequência, o quanto o
/// pino do mapa pode ser confiado.
///
/// Existe porque a coluna `latitude`/`longitude` sozinha não distingue "o dono
/// marcou o ponto da loja" de "geocodificamos o município e caiu na praça
/// central". Sem essa distinção, o município persistido virava definitivo: duas
/// lojas da mesma cidade no mesmo pino, e o "Como chegar" levando o cliente a
/// 1,5 km do lugar certo, para sempre.
///
/// `manual` nunca é sobrescrito. `city` é provisório — assim que a filial ganha
/// rua e número, a próxima leitura do mapa tenta subir para `address`.
enum GeocodePrecision {
  /// Informado na tela de configurações pelo próprio lojista.
  manual
  /// Geocodificado a partir de rua, número, bairro, CEP e cidade.
  address
  /// Só o município — aproximação, e o alvo de um upgrade futuro.
  city
}

enum FuelType {
  gasoline
  ethanol
  flex
  diesel
  hybrid
  electric
  gnv
}

enum TransmissionType {
  manual
  automatic
  cvt
  automated_manual
}

enum LeadStatus {
  new
  contacted
  qualified
  negotiating
  won
  lost
  archived
}

enum LeadSource {
  website
  app
  whatsapp
  phone
  walk_in
  referral
  social
  ad
  trade_in
  other
  /// Entrada de leads dos portais (OLX, Webmotors…). Qual portal fica no
  /// `metadata.portal` do lead — um valor por portal aqui multiplicaria o enum
  /// a cada integração nova.
  portal
}

enum AppointmentType {
  test_drive
  evaluation
  in_person
  online
  delivery
  service
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  canceled
  no_show
}

enum MessageKind {
  text
  image
  file
  vehicle_card
  system
}

enum ConversationStatus {
  open
  pending
  closed
}

enum NotificationChannel {
  in_app
  email
  push
  whatsapp
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

/// Faixas de preço, com os nomes comerciais.
///
/// Renomeado em `cobranca_asaas` (25/09/2026): era `starter`/`pro`/
/// `enterprise`, que não correspondiam a nada do que a tabela de preços
/// vende. Os valores e os limites de estoque moram em `CATALOGO_DE_PLANOS`
/// no `@autoconnect/shared`, e `paridade-enums.spec.ts` fixa a igualdade.
enum SubscriptionPlan {
  trial
  essencial
  crescimento
  profissional
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  paused
}

// ============ TENANT / SAAS ============

model Tenant {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String  @unique @db.Citext
  legalName         String  @map("legal_name")
  tradeName         String  @map("trade_name")
  taxId             String? @unique @map("tax_id") // CNPJ (14 dígitos, sem pontuação)
  stateRegistration String? @map("state_registration") // Inscrição Estadual (IE)
  primaryEmail      String  @map("primary_email") @db.Citext
  primaryPhone      String? @map("primary_phone")
  logoUrl           String? @map("logo_url")
  brandColor        String? @map("brand_color")
  websiteUrl        String? @map("website_url")
  timezone          String  @default("America/Sao_Paulo")
  isActive          Boolean @default(true) @map("is_active")
  acceptsTradeIn    Boolean @default(false) @map("accepts_trade_in")
  /// Loja de demonstração: a vitrine existe para o lojista em prospecção ver o
  /// produto funcionando (a landing linka `/c/demo`), e por isso fica fora da
  /// busca global, do mapa, das buscas salvas e dos alertas — um comprador de
  /// verdade não pode mandar lead para uma loja que não existe. A vitrine e a
  /// página do carro mostram o aviso.
  isDemo            Boolean @default(false) @map("is_demo")

  /// Representante legal que assina pela concessionária.
  ///
  /// Fica no tenant e não no negócio porque é a mesma pessoa em todos os
  /// contratos — pedir a cada venda seria digitação repetida e fonte de
  /// divergência. O contrato congela no snapshot, então trocar o
  /// representante depois não altera documento já emitido.
  legalRepName  String?  @map("legal_rep_name")
  legalRepCpf   String?  @map("legal_rep_cpf")
  /// Cargo: sócio-administrador, procurador, gerente…
  legalRepRole  String?  @map("legal_rep_role")
  /// Para onde o provedor de assinatura eletrônica manda o convite da loja.
  legalRepEmail String?  @map("legal_rep_email")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  subscription              TenantSubscription?
  branches                  DealershipBranch[]
  users                     User[]
  invitations               UserInvitation[]
  vehicles                  Vehicle[]
  leads                     Lead[]
  appointments              Appointment[]
  conversations             Conversation[]
  salesGoals                SalesGoal[]
  deals                     Deal[]
  dealPayments              DealPayment[]
  dealStatusEvents          DealStatusEvent[]
  tradeIns                  TradeIn[]
  vehicleAcquisitions       VehicleAcquisition[]
  vehicleCosts              VehicleCost[]
  contractTemplates         ContractTemplate[]
  dealContracts             DealContract[]
  contractSignatures        ContractSignature[]
  dealWarranties            DealWarranty[]
  vehicleQueries            VehicleQuery[]
  dealBuyers                DealBuyer[]
  contractSignatureRequests ContractSignatureRequest[]
  contractSignatureEvents   ContractSignatureEvent[]
  crmSettings               TenantCrmSettings?
  invoices                  TenantInvoice[]
  billingWebhookEvents      BillingWebhookEvent[]
  // Canais (WhatsApp oficial) — os modelos estão no fim do arquivo.
  whatsappAccounts          WhatsappAccount[]
  whatsappWebhookEvents     WhatsappWebhookEvent[]
  portalConnections         PortalConnection[]
  portalDeliveries          PortalDelivery[]
  pushSubscriptions         PushSubscription[]
  financialAccounts         FinancialAccount[]
  financialCategories       FinancialCategory[]
  financialEntries          FinancialEntry[]
  financialPeriods          FinancialPeriod[]
  bankTransactions          BankTransaction[]

  @@map("tenants")
}

model TenantSubscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  /// Plano **efetivo**: o que a loja tem hoje. Manda no limite de estoque e no
  /// veredito de `avaliarCobranca`. Só muda com pagamento confirmado (ou pela
  /// mão do super admin, que é o desbloqueio manual).
  plan               SubscriptionPlan   @default(trial)
  status             SubscriptionStatus @default(active)
  /// Plano **contratado e ainda não pago** — intenção, não direito.
  ///
  /// Existe porque `contratar` gravava o plano novo antes de qualquer
  /// pagamento: como `avaliarCobranca` lê "plano pago + `active`" como loja em
  /// dia, bastava contratar e nunca pagar para ficar com o plano — e com o teto
  /// de estoque dele — para sempre (defeito de 27/09/2026). Agora a
  /// contratação grava aqui, e só o `pagamento_confirmado` do webhook promove
  /// para `plan`. Constraint no banco recusa `trial` aqui: `trial` não é algo
  /// que se contrate.
  pendingPlan        SubscriptionPlan?  @map("pending_plan")
  /// Quando a contratação pendente foi feita. A tela mostra "contratado em"; a
  /// auditoria mostra quanto tempo ficou sem pagar.
  pendingSince       DateTime?          @map("pending_since") @db.Timestamptz()
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz()
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz()
  externalProvider   String?            @map("external_provider")
  /// Id da **assinatura** no gateway (`sub_...` na Asaas).
  externalId         String?            @map("external_id")
  /// Id do **cliente** no gateway (`cus_...` na Asaas). Sobrevive ao cancelamento
  /// da assinatura: a loja que volta não vira um segundo cadastro no gateway.
  externalCustomerId String?            @map("external_customer_id")
  /// Meio escolhido na contratação (`pix`, `boleto`, `cartao`, `indefinido`).
  paymentMethod      String?            @map("payment_method")
  /// Tabela de preço em que a loja contratou (`TABELAS_DE_PRECO`, no shared).
  /// Gravada na primeira contratação e mantida para sempre — a loja paga por
  /// ela mesmo depois que a tabela vigente subir, e em qualquer plano.
  priceTable         String?            @map("price_table")
  /// `mensal` ou `anual` (12 meses pelo preço de 10).
  billingCycle       String             @default("mensal") @map("billing_cycle")
  /// Até quando a loja escreve depois de vencer. `null` = sem fatura vencida.
  /// Gravado uma vez por vencimento — ver `aplicarEventoDeCobranca`.
  graceUntil         DateTime?          @map("grace_until") @db.Timestamptz()
  /// Quando a loja cancelou. Só informativo: quem bloqueia é o `status`.
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz()
  /// Último aviso de fim de trial/vencimento enviado, para o cron não repetir.
  lastNoticeAt       DateTime?          @map("last_notice_at") @db.Timestamptz()
  /// Cortesia: desde quando a loja é isenta de cobrança. `null` = paga como
  /// qualquer outra. `avaliarCobranca` decide por este campo antes de todo o
  /// resto — nenhum prazo vale para loja em cortesia. Só o super admin concede.
  courtesySince      DateTime?          @map("courtesy_since") @db.Timestamptz()
  /// `fundadora` ou `interna` (`MOTIVOS_DE_CORTESIA`, no shared).
  courtesyReason     String?            @map("courtesy_reason")
  /// Quem concedeu. O log de auditoria guarda o mesmo, com o histórico.
  courtesyGrantedBy  String?            @map("courtesy_granted_by") @db.Uuid
  /// Herdado do desenho por assento, sem uso: a cobrança é por loja e a faixa
  /// é de **estoque** (`CATALOGO_DE_PLANOS`). Usuários são ilimitados.
  seatsLimit         Int?               @map("seats_limit")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices TenantInvoice[]

  @@map("tenant_subscriptions")
}

/// Histórico de faturas da loja, espelhado do gateway.
///
/// Cópia local de propósito: a tela de cobrança abre sem depender da API do
/// gateway estar no ar, e o recibo continua existindo depois de a loja
/// cancelar. O `external_id` é a chave que o webhook usa para reencontrar a
/// fatura — daí o único por `(provider, external_id)`.
///
/// Dinheiro em `Decimal(14,2)`, como todo o resto do sistema.
model TenantInvoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  provider       String
  externalId     String    @map("external_id")
  /// `pendente | paga | vencida | estornada | cancelada` (`STATUS_DE_FATURA`).
  status         String
  amount         Decimal   @db.Decimal(14, 2)
  paymentMethod  String?   @map("payment_method")
  dueDate        DateTime  @map("due_date") @db.Timestamptz()
  paidAt         DateTime? @map("paid_at") @db.Timestamptz()
  /// Página de pagamento do gateway (Pix, boleto e cartão numa tela só).
  paymentUrl     String?   @map("payment_url")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([tenantId, dueDate])
  @@map("tenant_invoices")
}

/// Cada entrega de webhook do gateway, crua, para auditoria e idempotência.
///
/// Mesmo desenho de `contract_signature_events`: `(provider, event_key)` único,
/// onde a chave é o id do evento no gateway ou o SHA-256 do corpo. Quem tenta
/// gravar a segunda vez leva violação de único e o evento é descartado sem
/// reaplicar — que é o que impede um `PAYMENT_RECEIVED` reentregue de estender
/// o período de novo.
model BillingWebhookEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  provider   String
  eventKey   String   @map("event_key")
  kind       String
  applied    Boolean  @default(false)
  normalized Json
  rawBody    String   @map("raw_body")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventKey])
  @@index([tenantId, receivedAt])
  @@map("billing_webhook_events")
}

/// Autorização prévia para um saque na conta da **plataforma** no gateway.
///
/// Sem `tenant_id` de propósito: isto não é dado de concessionária nenhuma. É
/// o dinheiro do dono da plataforma saindo da conta da Asaas, e quem cria a
/// autorização é o super admin. Por isso a policy de RLS nega tudo ao papel da
/// aplicação — só a conexão privilegiada (dona das tabelas) alcança estas duas.
///
/// A Asaas exige, para liberar a chave de produção, que toda operação de saque
/// passe por um webhook nosso. A regra é recusa por padrão: o que não casar
/// com uma linha **válida, não usada e não expirada** daqui é `REFUSED`.
///
/// Uso único: `used_at` é gravado na mesma transação que registra a decisão.
model WithdrawalAuthorization {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       String    @default("asaas")
  /// `TRANSFER | BILL | PIX_QR_CODE | MOBILE_PHONE_RECHARGE | PIX_REFUND`.
  operationType  String    @map("operation_type")
  /// `exato` (valor idêntico) ou `teto` (até o valor) — `MODOS_DE_VALOR`.
  amountMode     String    @map("amount_mode")
  amount         Decimal   @db.Decimal(14, 2)
  /// Para que serve este saque, escrito por quem autorizou. Vira trilha.
  note           String?
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  usedAt         DateTime? @map("used_at") @db.Timestamptz()
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()
  /// Quem autorizou. Sem FK e com o e-mail copiado: a trilha de auditoria de
  /// dinheiro tem de sobreviver à remoção da conta que a criou.
  createdBy      String?   @map("created_by") @db.Uuid
  createdByEmail String?   @map("created_by_email")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  decisions WithdrawalDecision[]

  @@index([provider, operationType, expiresAt])
  @@map("withdrawal_authorizations")
}

/// Toda decisão de validação de saque, aprovada ou recusada, com o pedido cru.
///
/// É trilha de auditoria de dinheiro: guarda o corpo que chegou, a decisão, o
/// motivo, o instante e qual autorização foi consumida. Nada é apagado.
///
/// `(provider, operation_type, operation_key)` é único e serve de idempotência:
/// a Asaas reentrega quando a nossa resposta não chega, e a segunda entrega
/// **repete a decisão** em vez de recusar por falta de autorização (que já
/// teria sido consumida pela primeira). Pedido sem token válido nunca entra
/// com o id da operação — entra com `operation_type = 'NAO_AUTENTICADO'` e a
/// chave sendo o SHA-256 do corpo, senão qualquer um poderia envenenar a
/// decisão de uma operação futura só por adivinhar o id dela.
model WithdrawalDecision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String   @default("asaas")
  operationType   String   @map("operation_type")
  /// Id da operação no gateway — ou `sha256:<hash>` quando não há id confiável.
  operationKey    String   @map("operation_key")
  amount          Decimal? @db.Decimal(14, 2)
  /// `APPROVED` ou `REFUSED` — o que foi respondido, literalmente.
  decision        String
  /// `refuseReason` enviado à Asaas. Nulo quando aprovado.
  reason          String?
  authorizationId String?  @map("authorization_id") @db.Uuid
  /// O token do cabeçalho conferiu? Falso marca tentativa não autenticada.
  tokenOk         Boolean  @default(false) @map("token_ok")
  rawBody         String   @map("raw_body")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  authorization WithdrawalAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  @@unique([provider, operationType, operationKey])
  @@index([createdAt])
  @@map("withdrawal_decisions")
}

/// Ajustes de CRM da concessionária **e** o estado do rodízio de leads.
///
/// Tabela própria, e não `Tenant.settings`, porque a linha é travada com
/// `SELECT … FOR UPDATE` a cada lead que chega: é assim que dois leads
/// simultâneos não caem no mesmo vendedor. Travar a linha de `tenants` a cada
/// lead prenderia o cadastro inteiro da loja atrás da fila de leads.
///
/// Uma linha por concessionária, criada sob demanda (`ON CONFLICT DO NOTHING`):
/// loja que nunca abriu a tela de configuração roda com os padrões da coluna.
model TenantCrmSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Distribui sozinho o lead que chega sem responsável.
  rodizioAtivo          Boolean @default(true) @map("rodizio_ativo")
  /// Gerentes entram na fila junto dos vendedores.
  rodizioIncluiGerentes Boolean @default(false) @map("rodizio_inclui_gerentes")

  /// Minutos de **expediente** até o primeiro contato (padrão: 15).
  slaPrimeiroContatoMinutos Int     @default(15) @map("sla_primeiro_contato_minutos")
  /// Devolver à fila o lead que estourou o prazo. Padrão desligado de
  /// propósito: tirar o lead de um vendedor é decisão de gestão.
  slaDevolveParaFila        Boolean @default(false) @map("sla_devolve_para_fila")

  /// Padrão **desligado** desde 23/09/2026: carteira fechada, o vendedor vê só
  /// os próprios leads e os da fila. Ligado, todo mundo da loja vê tudo.
  vendedorVeTodosOsLeads Boolean @default(false) @map("vendedor_ve_todos_os_leads")

  /// Estado do rodízio: quem recebeu o último lead. A ordem segue daqui.
  rodizioUltimoUsuarioId String?   @map("rodizio_ultimo_usuario_id") @db.Uuid
  rodizioAtualizadoEm    DateTime? @map("rodizio_atualizado_em") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant               Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rodizioUltimoUsuario User?  @relation("RodizioUltimoUsuario", fields: [rodizioUltimoUsuarioId], references: [id], onDelete: SetNull)

  @@map("tenant_crm_settings")
}

model DealershipBranch {
  id               String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                                 @map("tenant_id") @db.Uuid
  name             String
  isHeadquarters   Boolean                                @default(false) @map("is_headquarters")
  phone            String?
  email            String?                                @db.Citext
  addressLine      String?                                @map("address_line")
  addressNumber    String?                                @map("address_number")
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  postalCode       String?                                @map("postal_code")
  country          String                                 @default("BR")
  location         Unsupported("geography(Point, 4326)")?
  latitude         Float?
  longitude        Float?
  /// Como as coordenadas acima foram obtidas. Ver `GeocodePrecision`.
  geocodePrecision GeocodePrecision?                      @map("geocode_precision")
  /// Quando a última tentativa de geocodificação aconteceu — inclusive a que
  /// falhou. É o que impede uma filial sem endereço de bater na Nominatim a
  /// cada abertura do mapa.
  geocodedAt       DateTime?                              @map("geocoded_at") @db.Timestamptz()
  businessHours    Json                                   @default("{}") @map("business_hours")
  isActive         Boolean                                @default(true) @map("is_active")
  createdAt        DateTime                               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime                               @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  salespeople      SalespersonProfile[]
  leads            Lead[]
  appointments     Appointment[]
  deals            Deal[]
  financialEntries FinancialEntry[]

  @@index([tenantId])
  @@map("dealership_branches")
}

// ============ USERS ============

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?    @map("tenant_id") @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  phone           String? // celular pessoal
  cpf             String?    @map("cpf") // CPF sem pontuação (tenant_admin)
  jobTitle        String?    @map("job_title") // Cargo / função (tenant_admin)
  avatarUrl       String?    @map("avatar_url")
  role            UserRole
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz()
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  tenant                     Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                   UserSession[]
  salespersonProfile         SalespersonProfile?
  customerProfile            CustomerProfile?
  favorites                  CustomerFavorite[]
  leadsAsCustomer            Lead[]                    @relation("LeadsAsCustomer")
  leadsAssigned              Lead[]                    @relation("LeadsAssigned")
  appointmentsAsCustomer     Appointment[]             @relation("AppointmentsAsCustomer")
  appointmentsAsSalesperson  Appointment[]             @relation("AppointmentsAsSalesperson")
  conversationsAsCustomer    Conversation[]            @relation("ConversationsAsCustomer")
  conversationsAsSalesperson Conversation[]            @relation("ConversationsAsSalesperson")
  messages                   Message[]
  availability               SalespersonAvailability[]
  notifications              Notification[]
  invitationsCreated         UserInvitation[]
  vehicleHistory             VehicleHistory[]
  leadInteractions           LeadInteraction[]
  analyticsEvents            AnalyticsEvent[]
  auditEntries               AuditLog[]
  vehicleViews               VehicleView[]
  priceAlerts                PriceAlert[]
  savedSearches              SavedSearch[]
  salesGoals                 SalesGoal[]
  dealsAsCustomer            Deal[]                    @relation("DealCustomer")
  dealsAsSalesperson         Deal[]                    @relation("DealSalesperson")
  dealStatusEvents           DealStatusEvent[]
