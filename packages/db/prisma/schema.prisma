// ============ LEADS ============

model Lead {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String     @map("tenant_id") @db.Uuid
  customerUserId         String?    @map("customer_user_id") @db.Uuid
  branchId               String?    @map("branch_id") @db.Uuid
  assignedTo             String?    @map("assigned_to") @db.Uuid
  vehicleId              String?    @map("vehicle_id") @db.Uuid
  contactName            String?    @map("contact_name")
  contactEmail           String?    @map("contact_email") @db.Citext
  contactPhone           String?    @map("contact_phone")
  /// Forma canônica do telefone (DDD + número, sem DDI nem pontuação, com o
  /// nono dígito). É por ela que a deduplicação compara — ver
  /// `normalizarTelefoneBr` no shared, que é quem a produz.
  contactPhoneNormalized String?    @map("contact_phone_normalized")
  source                 LeadSource @default(website)
  status                 LeadStatus @default(new)
  message                String?
  score                  Int?       @db.SmallInt
  lastActivityAt         DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz()
  wonAt                  DateTime?  @map("won_at") @db.Timestamptz()
  /// Complemento em texto livre do motivo da perda. Obrigatório quando o
  /// código é `outro` — ver `domain/motivo-perda.ts` no shared.
  lostReason             String?    @map("lost_reason")
  /// Motivo estruturado da perda, da lista fechada do shared. É o que o
  /// relatório agrupa; o texto acima é leitura humana.
  lostReasonCode         String?    @map("lost_reason_code")

  /// Prazo de primeiro contato: até quando alguém tem que ter falado com esta
  /// pessoa. Calculado na criação, em minutos de **expediente** da loja — ver
  /// `domain/sla.ts`. Nulo quando a loja não tem prazo configurável aplicável
  /// (nenhum dia aberto) ou quando o lead nasceu antes desta funcionalidade.
  firstResponseDueAt DateTime? @map("first_response_due_at") @db.Timestamptz()
  /// Quando houve a primeira interação de SAÍDA do vendedor (ligação,
  /// WhatsApp, e-mail ou chat). Nota interna não conta.
  firstRespondedAt   DateTime? @map("first_responded_at") @db.Timestamptz()
  /// Quando o estouro do prazo foi notificado. Existe para o cron ser
  /// idempotente: sem ela, o gerente receberia o mesmo alerta a cada rodada.
  slaBreachedAt      DateTime? @map("sla_breached_at") @db.Timestamptz()
  /// Consentimento LGPD do formulário público: quando foi aceito e o texto
  /// exibido no momento do aceite. O texto é copiado, não referenciado — a
  /// prova tem que ser do termo que a pessoa leu, não do termo de hoje.
  consentedAt        DateTime? @map("consented_at") @db.Timestamptz()
  consentText        String?   @map("consent_text")
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      User?             @relation("LeadsAsCustomer", fields: [customerUserId], references: [id])
  assignee      User?             @relation("LeadsAssigned", fields: [assignedTo], references: [id])
  branch        DealershipBranch? @relation(fields: [branchId], references: [id])
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id])
  interactions  LeadInteraction[]
  appointments  Appointment[]
  conversations Conversation[]
  deals         Deal[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assignedTo])
  @@index([vehicleId])
  // Sustenta a policy `cliente_relacionado` de users (ver migration 20260902150000).
  @@index([tenantId, customerUserId], map: "leads_tenant_customer_idx")
  // Deduplicação: a busca é sempre "dentro desta loja, com este telefone/e-mail".
  @@index([tenantId, contactPhoneNormalized], map: "leads_tenant_telefone_idx")
  @@index([tenantId, contactEmail], map: "leads_tenant_email_idx")
  // O índice que sustenta a varredura do cron de SLA é PARCIAL
  // (`leads_prazo_primeiro_contato_idx`, só o que tem prazo e ainda não
  // respondeu) e por isso vive apenas na migration — o Prisma não sabe
  // declarar `WHERE` num @@index. Mesma situação de
  // `deals_veiculo_negocio_vivo_idx`.
  // Contagem por motivo em GET /leads/stats.
  @@index([tenantId, lostReasonCode], map: "leads_tenant_motivo_perda_idx")
  @@map("leads")
}

model LeadInteraction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  kind        String
  content     String?
  payload     Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([leadId, occurredAt(sort: Desc)])
  @@map("lead_interactions")
}

// ============ AGENDAMENTOS ============

model Appointment {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                                 @map("tenant_id") @db.Uuid
  branchId           String?                                @map("branch_id") @db.Uuid
  /// Nulo quando a loja agendou para quem não tem conta — o contato vive nos
  /// campos `contact*` abaixo, ou no lead vinculado. A constraint
  /// `appointments_tem_contato` garante que um dos três existe.
  customerUserId     String?                                @map("customer_user_id") @db.Uuid
  contactName        String?                                @map("contact_name")
  contactPhone       String?                                @map("contact_phone")
  contactEmail       String?                                @map("contact_email") @db.Citext
  salespersonId      String?                                @map("salesperson_id") @db.Uuid
  vehicleId          String?                                @map("vehicle_id") @db.Uuid
  leadId             String?                                @map("lead_id") @db.Uuid
  type               AppointmentType
  status             AppointmentStatus                      @default(scheduled)
  scheduledStart     DateTime                               @map("scheduled_start") @db.Timestamptz()
  scheduledEnd       DateTime                               @map("scheduled_end") @db.Timestamptz()
  meetingUrl         String?                                @map("meeting_url")
  location           Unsupported("geography(Point, 4326)")?
  address            String?
  notes              String?
  cancellationReason String?                                @map("cancellation_reason")
  reminderSentAt     DateTime?                              @map("reminder_sent_at") @db.Timestamptz()
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      DealershipBranch? @relation(fields: [branchId], references: [id])
  customer    User?             @relation("AppointmentsAsCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  salesperson User?             @relation("AppointmentsAsSalesperson", fields: [salespersonId], references: [id])
  vehicle     Vehicle?          @relation(fields: [vehicleId], references: [id])
  lead        Lead?             @relation(fields: [leadId], references: [id])

  @@index([tenantId, scheduledStart])
  @@index([salespersonId, scheduledStart])
  @@index([customerUserId])
  @@index([tenantId, status])
  @@index([tenantId, customerUserId], map: "appointments_tenant_customer_idx")
  @@map("appointments")
}

model SalespersonAvailability {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salespersonId String   @map("salesperson_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  weekday       Int      @db.SmallInt
  startTime     DateTime @map("start_time") @db.Time(6)
  endTime       DateTime @map("end_time") @db.Time(6)

  salesperson User @relation(fields: [salespersonId], references: [id], onDelete: Cascade)

  @@index([salespersonId])
  @@map("salesperson_availability")
}

// ============ CHAT ============

model Conversation {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  /// Nulo quando a conversa é de um lead **sem conta** — o caso que a Onda 0
  /// criou e o chat não atendia. Ver `contactName` e `guestTokenHash`.
  customerUserId         String?             @map("customer_user_id") @db.Uuid
  /// Contato **copiado** do lead, como no agendamento sem conta: a conversa
  /// precisa dizer com quem é mesmo que o lead seja apagado depois.
  contactName            String?             @map("contact_name")
  contactPhone           String?             @map("contact_phone")
  contactEmail           String?             @map("contact_email") @db.Citext
  /// sha256 do link de acesso do visitante sem conta (o mesmo esquema de
  /// `UserInvitation.tokenHash`). É a única porta de entrada dele — sem isso a
  /// loja escreveria para ninguém.
  guestTokenHash         String?             @unique @map("guest_token_hash")
  salespersonId          String?             @map("salesperson_id") @db.Uuid
  vehicleId              String?             @map("vehicle_id") @db.Uuid
  leadId                 String?             @map("lead_id") @db.Uuid
  status                 ConversationStatus  @default(open)
  lastMessageAt          DateTime?           @map("last_message_at") @db.Timestamptz()
  unreadCountCustomer    Int                 @default(0) @map("unread_count_customer")
  unreadCountSalesperson Int                 @default(0) @map("unread_count_salesperson")
  /// Por onde a conversa acontece. `chat` é o do próprio sistema (cliente com
  /// conta, ou visitante pelo link); `whatsapp` entra e sai pelo número oficial
  /// da loja — ver `modules/whatsapp`.
  channel                ConversationChannel @default(chat)
  /// Número da loja por onde a conversa de WhatsApp passa.
  whatsappAccountId      String?             @map("whatsapp_account_id") @db.Uuid
  /// Telefone do cliente na forma canônica (`contatoDoWhatsApp` no shared). É a
  /// chave que junta a resposta do cliente à conversa que a loja abriu — o
  /// `wa_id` sozinho não serve, porque às vezes vem sem o nono dígito.
  contactPhoneNormalized String?             @map("contact_phone_normalized")
  /// Endereço do cliente no canal (o `wa_id`), gravado quando ele escreve.
  externalContactId      String?             @map("external_contact_id")
  /// Última mensagem **do cliente**. No WhatsApp, é o que abre e fecha a
  /// janela de 24 h de mensagem livre (`janelaDeAtendimentoAberta`).
  customerLastMessageAt  DateTime?           @map("customer_last_message_at") @db.Timestamptz()
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        User?            @relation("ConversationsAsCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  salesperson     User?            @relation("ConversationsAsSalesperson", fields: [salespersonId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  lead            Lead?            @relation(fields: [leadId], references: [id])
  /// `NoAction`, não `SetNull`: a conversa de WhatsApp sem número violaria
  /// `conversations_tem_quem_responde`. O número nunca é apagado (desconectar
  /// é `active = false`), e na exclusão da loja os dois somem no mesmo comando.
  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: NoAction)
  messages        Message[]

  @@index([tenantId])
  @@index([customerUserId])
  @@index([salespersonId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, customerUserId], map: "conversations_tenant_customer_idx")
  // Uma conversa de WhatsApp viva por número da loja e cliente: índice único
  // PARCIAL (`conversations_whatsapp_viva_idx`), só na migration — duas
  // entregas simultâneas do mesmo cliente abririam duas conversas sem ele.
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  senderUserId   String?     @map("sender_user_id") @db.Uuid
  kind           MessageKind @default(text)
  body           String?
  attachmentUrl  String?     @map("attachment_url")
  vehicleRefId   String?     @map("vehicle_ref_id") @db.Uuid
  metadata       Json        @default("{}")
  readAt         DateTime?   @map("read_at") @db.Timestamptz()
  deliveredAt    DateTime?   @map("delivered_at") @db.Timestamptz()
  /// Id da mensagem no canal externo (o `wamid` do WhatsApp). Único por loja:
  /// é o que torna inofensiva a reentrega do webhook.
  externalId     String?     @map("external_id")
  /// `STATUS_DE_ENTREGA` do shared, para o que a loja mandou por canal externo.
  /// Nulo no chat interno e nas mensagens recebidas.
  deliveryStatus String?     @map("delivery_status")
  /// Por que o canal recusou a mensagem, quando `deliveryStatus = 'falhou'`.
  failureReason  String?     @map("failure_reason")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id])
  vehicleRef   Vehicle?     @relation(fields: [vehicleRefId], references: [id])

  @@unique([tenantId, externalId], map: "messages_tenant_external_id_key")
  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("messages")
}

// ============ NOTIFICACOES ============

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?             @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus  @default(pending)
  title     String
  body      String?
  data      Json                @default("{}")
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz()
  readAt    DateTime?           @map("read_at") @db.Timestamptz()
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============ ANALYTICS / AUDIT ============

model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id")
  eventName  String   @map("event_name")
  properties Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([eventName])
  @@map("analytics_events")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  diff        Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ============ ALERTAS DE PRECO ============

model PriceAlert {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  targetPrice Decimal   @map("target_price") @db.Decimal(14, 2)
  isActive    Boolean   @default(true) @map("is_active")
  triggeredAt DateTime? @map("triggered_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([vehicleId, isActive])
  @@map("price_alerts")
}

model SavedSearch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  filters      Json     @default("{}")
  lastViewedAt DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model SalesGoal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // null = meta geral da equipe
  period      String // "YYYY-MM"
  target      Int // meta de vendas (negócios fechados) no período
  /// Meta em reais. Opcional para não quebrar as metas já cadastradas — a
  /// loja pensa em faturamento, não em contagem, e quem só tem `target`
  /// continua funcionando.
  targetValue Decimal? @map("target_value") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, period])
  @@map("sales_goals")
}

// ─────────────────────────────────────────────────────────
// Vendas — o negócio, seu pagamento e o custo do veículo
//
// Antes disto o sistema sabia dizer que um carro foi vendido, mas não por
// quanto ele entrou nem quanto custou preparar — ou seja, não sabia responder
// se deu lucro. `VehicleAcquisition` e `VehicleCost` existem para isso.
// ─────────────────────────────────────────────────────────

enum DealStatus {
  draft
  proposal
  negotiating
  awaiting_credit
  contract_issued
  signed
  invoiced
  documentation
  delivered
  // Antes da assinatura o negócio é cancelado; depois dela é distratado.
  // São eventos jurídicos diferentes e o sistema não os confunde.
  canceled
  rescinded
}

enum PaymentKind {
  cash
  down_payment
  trade_in
  financing
  consortium
  other
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded
}

enum AcquisitionOrigin {
  direct_purchase
  trade_in
  consignment
  dealer_transfer
  auction
  // Já previsto para quando entrar concessionária de marca.
  factory
}

enum VehicleCostKind {
  preparation
  mechanical
  bodywork
  documentation
  transport
  commission
  other
}

model Deal {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  branchId       String?    @map("branch_id") @db.Uuid
  leadId         String?    @map("lead_id") @db.Uuid
  vehicleId      String     @map("vehicle_id") @db.Uuid
  customerUserId String?    @map("customer_user_id") @db.Uuid
  salespersonId  String?    @map("salesperson_id") @db.Uuid
  status         DealStatus @default(draft)

  // Dinheiro é sempre Decimal(14,2). Nunca Float, nunca Number no cálculo.
  listPrice Decimal @map("list_price") @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  saleValue Decimal @map("sale_value") @db.Decimal(14, 2)

  // Congelados no fechamento: o custo do veículo muda depois, a margem não pode.
  vehicleCostSnapshot Decimal? @map("vehicle_cost_snapshot") @db.Decimal(14, 2)
  grossMargin         Decimal? @map("gross_margin") @db.Decimal(14, 2)

  closedAt         DateTime? @map("closed_at") @db.Timestamptz()
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz()
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz()
  /// Complemento em texto livre. Obrigatório quando o código é `outro`.
  cancelReason     String?   @map("cancel_reason")
  /// Motivo estruturado do cancelamento ou distrato, da lista fechada do
  /// shared. Era só o texto livre acima, e o funil de valor não conseguia
  /// dizer por que o dinheiro não entrou.
  cancelReasonCode String?   @map("cancel_reason_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           DealershipBranch? @relation(fields: [branchId], references: [id])
  lead             Lead?             @relation(fields: [leadId], references: [id])
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  customer         User?             @relation("DealCustomer", fields: [customerUserId], references: [id])
  salesperson      User?             @relation("DealSalesperson", fields: [salespersonId], references: [id])
  payments         DealPayment[]
  statusEvents     DealStatusEvent[]
  tradeIn          TradeIn?
  contracts        DealContract[]
  warranty         DealWarranty?
  buyer            DealBuyer?
  /// Contas a receber geradas por este negócio (Fase 3 do financeiro).
  financialEntries FinancialEntry[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([vehicleId])
  @@map("deals")
}

model DealPayment {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  dealId   String        @map("deal_id") @db.Uuid
  kind     PaymentKind
  status   PaymentStatus @default(pending)
  value    Decimal       @db.Decimal(14, 2)

  // Financiamento e consórcio: quem financiou, em quantas parcelas.
  institution      String?
  installments     Int?      @db.SmallInt
  installmentValue Decimal?  @map("installment_value") @db.Decimal(14, 2)
  notes            String?
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal           Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// O lançamento que esta parcela gerou — um só, por construção.
  financialEntry FinancialEntry?

  @@index([tenantId])
  @@index([dealId])
  @@map("deal_payments")
}

model DealStatusEvent {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  dealId      String     @map("deal_id") @db.Uuid
  fromStatus  DealStatus @map("from_status")
  toStatus    DealStatus @map("to_status")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  reason      String?
  occurredAt  DateTime   @default(now()) @map("occurred_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([dealId, occurredAt(sort: Desc)])
  @@map("deal_status_events")
}

model TradeIn {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  dealId   String @unique @map("deal_id") @db.Uuid

  // Descrição do usado antes de virar estoque.
  brandName    String  @map("brand_name")
  modelName    String  @map("model_name")
  versionName  String? @map("version_name")
  yearModel    Int     @map("year_model")
  yearMake     Int     @map("year_make")
  mileageKm    Int     @map("mileage_km")
  licensePlate String? @map("license_plate")
  color        String?

  fipeReference  String?  @map("fipe_reference")
  fipeValue      Decimal? @map("fipe_value") @db.Decimal(14, 2)
  appraisedValue Decimal  @map("appraised_value") @db.Decimal(14, 2)
  acceptedValue  Decimal  @map("accepted_value") @db.Decimal(14, 2)

  // Preenchido quando o usado é cadastrado no estoque.
  vehicleId String? @unique @map("vehicle_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@map("trade_ins")
}

model VehicleAcquisition {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  vehicleId String            @unique @map("vehicle_id") @db.Uuid
  origin    AcquisitionOrigin

  supplierName     String?  @map("supplier_name")
  supplierDocument String?  @map("supplier_document")
  purchaseValue    Decimal  @map("purchase_value") @db.Decimal(14, 2)
  enteredAt        DateTime @map("entered_at") @db.Timestamptz()
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// A conta a pagar que esta compra gerou — uma só, por construção.
  financialEntry FinancialEntry?

  @@index([tenantId])
  @@map("vehicle_acquisitions")
}

model VehicleCost {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  vehicleId String          @map("vehicle_id") @db.Uuid
  kind      VehicleCostKind
  value     Decimal         @db.Decimal(14, 2)

  description  String?
  supplierName String?  @map("supplier_name")
  incurredAt   DateTime @map("incurred_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// A conta a pagar deste item de preparação.
  financialEntry FinancialEntry?

  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_costs")
}

// ─────────────────────────────────────────────────────────
// Contrato
//
// A partir daqui o sistema emite documento com efeito jurídico, e o desenho
// reflete isso: o que foi emitido não muda, e é preciso poder provar.
// ─────────────────────────────────────────────────────────

enum ContractStatus {
  draft
  issued
  signed
  voided
}

enum SignerRole {
  customer
  dealer
}

model ContractTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  /// Editar um template nunca altera contrato já emitido: cria versão nova.
  /// O contrato aponta para a versão exata que usou.
  version  Int    @default(1)

  /// Estrutura de blocos, não HTML livre — o gerador precisa produzir sempre
  /// o mesmo byte para o mesmo modelo, senão o hash deixa de significar algo.
  blocks   Json
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts DealContract[]

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@map("contract_templates")
}

model DealContract {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  dealId     String         @map("deal_id") @db.Uuid
  templateId String         @map("template_id") @db.Uuid
  status     ContractStatus @default(draft)

  /// Cópia congelada dos dados da emissão. É snapshot e não join de propósito:
  /// se o preço do veículo mudar depois, o contrato assinado não muda junto.
  snapshot Json

  /// SHA-256 do PDF no momento em que ele nasce. Prova que o arquivo não foi
  /// trocado, e é a base de qualquer integração de assinatura depois.
  contentHash String  @map("content_hash")
  /// Caminho no armazenamento privado. Nunca URL pública.
  storageKey  String? @map("storage_key")

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz()
  signedAt   DateTime? @map("signed_at") @db.Timestamptz()
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz()
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal              Deal                       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  template          ContractTemplate           @relation(fields: [templateId], references: [id])
  signatures        ContractSignature[]
  signatureRequests ContractSignatureRequest[]

  @@index([tenantId, dealId])
  @@map("deal_contracts")
}

model ContractSignature {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  contractId String     @map("contract_id") @db.Uuid
  role       SignerRole

  signerUserId   String? @map("signer_user_id") @db.Uuid
  signerName     String  @map("signer_name")
  signerDocument String? @map("signer_document")

  /// Trilha de evidências do aceite. Sem provedor externo ainda, é isto que
  /// sustenta a assinatura — e é o mesmo conjunto que qualquer provedor pede.
  ip           String?
  userAgent    String? @map("user_agent")
  /// Hash do documento que a pessoa aceitou. Se o contrato for reemitido, o
  /// hash muda e a assinatura antiga deixa de casar — que é o comportamento
  /// correto, não um bug.
  acceptedHash String  @map("accepted_hash")

  /// Assinatura feita no provedor externo: a evidência é a solicitação (com
  /// os eventos crus do webhook) e o id do signatário lá — não ip/userAgent,
  /// que o provedor guarda do lado dele. Nulo na assinatura interna.
  requestId        String? @map("request_id") @db.Uuid
  externalSignerId String? @map("external_signer_id")

  signedAt DateTime @default(now()) @map("signed_at") @db.Timestamptz()

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract DealContract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signer   User?                     @relation(fields: [signerUserId], references: [id])
  request  ContractSignatureRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@unique([contractId, role])
  @@index([tenantId])
  @@map("contract_signatures")
}

model DealWarranty {
  dealId   String @id @map("deal_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Legal: CDC art. 26, II. 90 dias, cobre o veículo inteiro. Não é campo de
  /// negociação — é constante contada a partir da entrega.
  legalDays     Int       @default(90) @map("legal_days")
  legalStartsAt DateTime? @map("legal_starts_at") @db.Timestamptz()

  /// Contratual: aditiva, opcional, escopo livre. Nunca reduz a legal.
  contractualMonths Int?    @map("contractual_months")
  contractualScope  String? @map("contractual_scope")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("deal_warranties")
}

// ─────────────────────────────────────────────────────────
// Consultas veiculares
//
// Integração externa entra por camada de anticorrupção: o resto do sistema
// nunca vê o formato do fornecedor. E **cada chamada custa dinheiro**, o que
// muda o desenho: cache persistente, custo registrado e idempotência por dia
// para que clique duplo não seja cobrado duas vezes.
// ─────────────────────────────────────────────────────────

enum VehicleQueryKind {
  ownership
  debts
  auction
  theft
  fines
  history
}

enum VehicleQueryStatus {
  pending
  success
  failed
}

model VehicleQuery {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  /// Opcional: a loja consulta a placa antes de cadastrar o veículo.
  vehicleId String? @map("vehicle_id") @db.Uuid

  plate  String?
  vin    String?
  kind   VehicleQueryKind
  status VehicleQueryStatus @default(pending)

  /// Qual fornecedor respondeu. Guardado porque o mesmo tipo de consulta pode
  /// mudar de fornecedor, e o histórico precisa dizer quem disse o quê.
  provider String

  /// Resposta crua do fornecedor, exatamente como veio. Quando ele mudar o
  /// payload, o histórico continua auditável — e é o que permite reprocessar
  /// sem pagar de novo.
  rawResponse Json? @map("raw_response")
  /// Resultado normalizado, no formato do domínio.
  result      Json?

  /// Custo da chamada em centavos. É requisito, não enfeite: sem ele a loja
  /// não sabe quanto gastou em consulta no mês.
  costCents Int? @map("cost_cents")

  /// `tenant:alvo:tipo:AAAA-MM-DD`. Impede pagar duas vezes pelo mesmo clique.
  idempotencyKey String   @unique @map("idempotency_key")
  /// Fim da validade do cache. Consulta válida é reaproveitada sem nova chamada.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()

  errorMessage String?  @map("error_message")
  queriedAt    DateTime @default(now()) @map("queried_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, queriedAt(sort: Desc)])
  @@index([vehicleId, kind])
  @@map("vehicle_queries")
}

/// Identificação do comprador para o contrato.
///
/// Mora no negócio, e não no perfil do cliente, por dois motivos: a
/// concessionária não escreve em `customer_profiles`, que é isolado por
/// `app.user_id`; e o contrato precisa do dado como estava na emissão — se o
/// cliente mudar o endereço depois, o contrato assinado não muda junto.
model DealBuyer {
  dealId   String @id @map("deal_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Nome como consta no documento, que pode diferir do nome de cadastro.
  fullName String  @map("full_name")
  cpf      String
  rg       String?
  rgIssuer String? @map("rg_issuer")

  /// Nacionalidade, estado civil e profissão são praxe na qualificação das
  /// partes em contrato de compra e venda.
  nationality   String? @default("brasileiro(a)")
  maritalStatus String? @map("marital_status")
  occupation    String?

  addressLine   String? @map("address_line")
  addressNumber String? @map("address_number")
  neighborhood  String?
  city          String?
  state         String? @db.Char(2)
  postalCode    String? @map("postal_code")

  /// Para onde o provedor de assinatura eletrônica manda o convite. Sem ele,
  /// o envio usa o e-mail da conta do cliente vinculado ao negócio.
  email String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("deal_buyers")
}

// ─────────────────────────────────────────────────────────
// Assinatura eletrônica externa
//
// Mesma camada de anticorrupção da consulta veicular: o provedor entra por um
// adaptador, e o que fica aqui é o vocabulário do domínio. A resposta vem por
// webhook — assíncrona, repetida e fora de ordem —, então cada entrega é
// guardada crua e a aplicação é idempotente.
// ─────────────────────────────────────────────────────────

enum SignatureRequestStatus {
  pending
  sent
  completed
  refused
  expired
  canceled
  failed
}

/// Um envio do contrato para o provedor. No máximo um vivo por contrato
/// (índice único parcial `contract_signature_requests_viva_idx`, só na
/// migration — o Prisma não expressa índice parcial).
model ContractSignatureRequest {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  contractId String                 @map("contract_id") @db.Uuid
  provider   String
  /// Id do envelope no provedor. Nulo enquanto `pending` e em `failed`.
  externalId String?                @map("external_id")
  status     SignatureRequestStatus @default(pending)

  /// Hash do PDF enviado. É o `contentHash` do contrato — guardado aqui para
  /// que a solicitação prove sozinha o que foi mandado.
  contentHash String    @map("content_hash")
  /// Signatários com id externo, status e horário de cada um.
  signers     Json
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()

  /// PDF assinado devolvido pelo provedor: chave no bucket privado (nula sem
  /// armazenamento configurado) e SHA-256, conferido a cada download.
  signedStorageKey String? @map("signed_storage_key")
  signedHash       String? @map("signed_hash")

  errorMessage String?   @map("error_message")
  cancelReason String?   @map("cancel_reason")
  sentAt       DateTime? @map("sent_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract   DealContract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  events     ContractSignatureEvent[]
  signatures ContractSignature[]

  @@unique([provider, externalId])
  @@index([tenantId, contractId])
  @@map("contract_signature_requests")
}

/// Cada entrega de webhook, crua. É a trilha de auditoria da assinatura
/// externa e a trava de idempotência: `(request_id, event_key)` é único, então
/// a mesma entrega repetida não é aplicada duas vezes.
model ContractSignatureEvent {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  requestId  String  @map("request_id") @db.Uuid
  /// Id do evento no provedor, ou o SHA-256 do corpo cru quando não houver.
  eventKey   String  @map("event_key")
  kind       String
  /// Falso quando o evento chegou atrasado ou repetido e não mudou o estado.
  applied    Boolean @default(false)
  /// Evento normalizado, no vocabulário do domínio.
  normalized Json
  /// Corpo exatamente como chegou: permite reconferir o HMAC depois.
  rawBody    String  @map("raw_body")

  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()

  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ContractSignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, eventKey])
  @@index([tenantId])
  @@map("contract_signature_events")
}

// ============ CANAIS: WHATSAPP OFICIAL ============
//
// Camada neutra: o provedor (a API de nuvem da Meta, ou o simulado) fica atrás
// de `ProvedorDeWhatsApp`, e nada aqui guarda o payload dele. O porquê de cada
// regra: `docs/decisoes/2026-09-27 whatsapp oficial.md`.

/// Por onde uma conversa acontece — ver `Conversation.channel`.
enum ConversationChannel {
  chat
  whatsapp
}

/// O número de WhatsApp oficial de uma loja.
///
/// Uma conta **ativa** por loja e um número ativo em uma loja só — os dois são
/// índices únicos parciais na migration (`whatsapp_accounts_uma_ativa_por_loja_idx`
/// e `whatsapp_accounts_numero_ativo_idx`). O segundo é o que importa: o
/// webhook acha a loja pelo id do número, e dois donos para o mesmo número
/// mandariam a conversa de uma loja para a outra.
///
/// Desconectar não apaga: `active = false` preserva as conversas que passaram
/// por ele, e reconectar o mesmo número reativa a linha.
model WhatsappAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  provider       String
  /// Id do número no provedor (`phone_number_id` na Meta).
  externalId     String    @map("external_id")
  /// O número que o cliente vê, na forma canônica.
  displayPhone   String    @map("display_phone")
  active         Boolean   @default(true)
  /// Quem conectou. Sem chave estrangeira de propósito: é registro de
  /// auditoria, e sobrevive à saída da pessoa da equipe.
  connectedBy    String?   @map("connected_by") @db.Uuid
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz()
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([provider, externalId])
  @@map("whatsapp_accounts")
}

/// Cada evento recebido do provedor, uma linha — a idempotência e a trilha.
///
/// O corpo cru **não** é guardado, ao contrário da cobrança e da assinatura:
/// uma entrega da Meta pode trazer eventos de várias contas (uma por loja), e
/// gravá-la inteira na linha de uma loja guardaria a conversa da outra. Fica o
/// evento normalizado, que é só desta loja, e o SHA-256 do corpo, que prova de
/// qual entrega ele saiu.
model WhatsappWebhookEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  provider   String
  /// `chaveDoEventoDeWhatsApp` do shared: `msg:<id>` ou `status:<id>:<status>`.
  eventKey   String   @map("event_key")
  kind       String
  applied    Boolean  @default(false)
  normalized Json
  rawSha256  String   @map("raw_sha256")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventKey])
  @@index([tenantId, receivedAt])
  @@map("whatsapp_webhook_events")
}

// ============ CANAIS: LEADS DOS PORTAIS ============
//
// "Capturar agora, entender depois": toda entrega é guardada crua; o que o
// sistema sabe ler vira lead, o resto fica visível e é reprocessado quando o
// leitor do portal existir. O porquê: `docs/decisoes/2026-09-27 leads dos portais.md`.

/// O endereço de entrada de uma loja para um portal: a URL de webhook e o
/// e-mail de encaminhamento carregam o mesmo token.
///
/// Só o hash do token é guardado, como no link do visitante e no convite de
/// equipe: o endereço aparece uma vez, na hora de conectar, e gerar outro
/// invalida o anterior. Uma conexão ativa por loja e portal (índice parcial
/// `portal_connections_uma_ativa_idx`, na migration).
model PortalConnection {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// `CHAVES_DE_PORTAL` do shared: olx, webmotors, icarros, mercadolivre, outro.
  portal         String
  tokenHash      String    @unique @map("token_hash")
  active         Boolean   @default(true)
  createdBy      String?   @map("created_by") @db.Uuid
  lastReceivedAt DateTime? @map("last_received_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries PortalDelivery[]

  @@index([tenantId])
  @@map("portal_connections")
}

/// Cada entrega recebida de um portal, crua — a trilha, a idempotência e a
/// matéria-prima do reprocessamento.
///
/// Aqui o corpo cru **é** guardado (no WhatsApp, não): o endereço é de uma loja
/// só, então a entrega inteira é dela. É o que permite reler, com o leitor novo,
/// o e-mail que o leitor antigo não entendeu.
model PortalDelivery {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  portal       String
  /// `webhook` ou `email`.
  transport    String
  /// Id do e-mail no provedor, id do lead no portal, ou o SHA-256 do corpo.
  eventKey     String    @map("event_key")
  /// `SITUACOES_DE_ENTREGA_DE_PORTAL` do shared.
  status       String
  /// O que mostrar na tela: o assunto do e-mail, ou o nome do lead.
  summary      String?
  /// Leads criados (ou encontrados pela deduplicação) a partir desta entrega.
  leadIds      String[]  @default([]) @map("lead_ids") @db.Uuid
  rawBody      String    @map("raw_body")
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  processedAt  DateTime? @map("processed_at") @db.Timestamptz()

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection PortalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, eventKey])
  @@index([tenantId, receivedAt])
  @@map("portal_deliveries")
}

// ============ CANAIS: PUSH DO VENDEDOR ============

/// Um aparelho (navegador) em que o vendedor ativou notificação push.
///
/// O endpoint é do serviço de push do navegador (Google, Mozilla, Apple) e
/// identifica o aparelho: único, e o mesmo aparelho reinscrito atualiza a
/// linha em vez de duplicar o aviso. Inscrição que o serviço declara expirada
/// (404/410) sai daqui no primeiro envio que falha — é o navegador dizendo que
/// desinstalaram o app ou limparam os dados.
model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// ============ FINANCEIRO DA LOJA ============
//
// Decidido em 27/09/2026 (docs/decisoes/2026-09-27 modulo financeiro.md):
// financeiro **gerencial** — a pagar, a receber, caixa, DRE mensal, fechamento
// e conciliação. Fiscal (SPED, apuração) e folha ficam fora.
//
// Três decisões estão no desenho destas tabelas:
//
//  1. **Saldo não é coluna.** Nenhuma tabela aqui guarda saldo: ele é a soma dos
//     lançamentos pagos mais o saldo inicial da conta. Saldo gravado vira saldo
//     errado no primeiro lançamento editado.
//  2. **`value` é sempre positivo** e o sinal está em `direction`. Um CHECK
//     garante; valor negativo para representar saída é soma que engana.
//  3. **Nada apaga.** Lançamento errado vira `cancelado` com motivo, e a linha
//     fica — é o que permite conferir o caixa de três meses atrás.

enum FinancialAccountKind {
  caixa
  banco
  adquirente
  outro
}

enum FinancialDirection {
  entrada
  saida
}

/// `previsto` é promessa, `pago` é fato, `cancelado` é erro assumido.
enum FinancialEntryStatus {
  previsto
  pago
  cancelado
}

enum FinancialCategoryGroup {
  veiculos
  operacao
  pessoal
  impostos
  financeiro
  outros
}

/// Onde o dinheiro está: o caixa da loja, cada banco, cada adquirente.
///
/// `openingBalance` existe porque a loja começa a usar o sistema no meio da vida
/// dela: sem saldo inicial, o primeiro mês mostraria um caixa que nunca existiu.
model FinancialAccount {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  kind           FinancialAccountKind
  name           String
  bankName       String?              @map("bank_name")
  openingBalance Decimal              @default(0) @map("opening_balance") @db.Decimal(14, 2)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]
  transactions BankTransaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("financial_accounts")
}

/// Plano de contas curto, por loja.
///
/// Nasce semeado com `CATEGORIAS_PADRAO` (shared) porque uma tela de financeiro
/// que abre vazia e exige cadastrar categoria antes do primeiro lançamento é uma
/// tela que o lojista fecha. A loja renomeia, desativa e cria as suas.
model FinancialCategory {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  direction FinancialDirection
  group     FinancialCategoryGroup
  name      String
  active    Boolean                @default(true)
  /// Chave estável das categorias que a **geração automática** procura
  /// (`venda_de_veiculo`, `compra_de_veiculo`, `preparacao`, `comissao`). A busca
  /// é por ela e nunca pelo nome: a loja renomeia, e buscar por nome pararia de
  /// achar em silêncio — o lançamento simplesmente não apareceria.
  originKey String?                @map("origin_key")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries FinancialEntry[]

  @@unique([tenantId, direction, name])
  @@unique([tenantId, originKey])
  @@index([tenantId])
  @@map("financial_categories")
}

/// O lançamento: uma promessa de dinheiro entrando ou saindo, e o fato quando
/// acontece.
///
/// `dueDate` é a promessa e `paidAt` é o fato — regime de caixa, que é como a
/// loja pensa. Os vínculos opcionais (`dealId`, `vehicleId`, `dealPaymentId`) são
/// o que evita dupla contagem com o DRE por veículo: o financeiro **aponta** para
/// a linha de origem em vez de copiar o valor dela.
model FinancialEntry {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  direction FinancialDirection
  status    FinancialEntryStatus @default(previsto)
  value     Decimal              @db.Decimal(14, 2)

  dueDate DateTime  @map("due_date") @db.Timestamptz()
  paidAt  DateTime? @map("paid_at") @db.Timestamptz()

  description    String
  supplierName   String? @map("supplier_name")
  documentNumber String? @map("document_number")
  notes          String?

  accountId  String? @map("account_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid

  /// Origem: quando o lançamento nasceu de algo que a loja já fez no sistema.
  dealId               String? @map("deal_id") @db.Uuid
  vehicleId            String? @map("vehicle_id") @db.Uuid
  /// Único: a parcela do negócio gera **um** lançamento, e regerar não duplica.
  dealPaymentId        String? @unique @map("deal_payment_id") @db.Uuid
  /// Idem para a compra do veículo e para cada item de preparação. São FKs
  /// explícitas, e não um par `origem_tabela`/`origem_id` genérico, porque é a
  /// unicidade da coluna que torna a geração idempotente **por construção** —
  /// rodar duas vezes não cria a segunda conta a pagar.
  vehicleAcquisitionId String? @unique @map("vehicle_acquisition_id") @db.Uuid
  vehicleCostId        String? @unique @map("vehicle_cost_id") @db.Uuid

  /// Mesma série de uma repetição (aluguel, salário). Sem tabela própria: a
  /// série só precisa ser reconhecível para editar ou cancelar as futuras.
  recurrenceId String? @map("recurrence_id") @db.Uuid

  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz()
  cancelReason String?   @map("cancel_reason")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account         FinancialAccount?   @relation(fields: [accountId], references: [id])
  category        FinancialCategory   @relation(fields: [categoryId], references: [id])
  branch          DealershipBranch?   @relation(fields: [branchId], references: [id])
  deal            Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dealPayment     DealPayment?        @relation(fields: [dealPaymentId], references: [id], onDelete: SetNull)
  aquisicao       VehicleAcquisition? @relation(fields: [vehicleAcquisitionId], references: [id], onDelete: SetNull)
  /// A linha do extrato conciliada com este lançamento, quando houver.
  bankTransaction BankTransaction?
  custo           VehicleCost?        @relation(fields: [vehicleCostId], references: [id], onDelete: SetNull)
  autor           User?               @relation(fields: [createdBy], references: [id])

  @@index([tenantId, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, accountId, status])
  @@index([tenantId, categoryId])
  @@index([recurrenceId])
  @@map("financial_entries")
}

/// Uma linha do extrato do banco, importada de um OFX.
///
/// `fitid` é o id que o banco dá à transação: único por conta, e é ele que faz
/// reimportar o mesmo arquivo — ou um arquivo que se sobrepõe ao anterior, que é
/// o caso comum — **não duplicar** nada. Mesmo desenho de idempotência dos
/// webhooks, pela mesma razão: o segundo arquivo sempre vem.
model BankTransaction {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  accountId  String             @map("account_id") @db.Uuid
  fitid      String
  /// Dia do lançamento no banco, meia-noite UTC — a hora do arquivo é descartada.
  postedAt   DateTime           @map("posted_at") @db.Timestamptz()
  /// Sempre positivo; o sinal está em `direction`, como no lançamento.
  amount     Decimal            @db.Decimal(14, 2)
  direction  FinancialDirection
  memo       String?
  /// O lançamento com que esta linha foi conciliada. Nulo = ainda sobrando.
  entryId    String?            @unique @map("entry_id") @db.Uuid
  /// Marcada como "não é da loja": tarifa já lançada, transferência interna.
  ignoredAt  DateTime?          @map("ignored_at") @db.Timestamptz()
  importedAt DateTime           @default(now()) @map("imported_at") @db.Timestamptz()

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entry   FinancialEntry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([accountId, fitid])
  @@index([tenantId, postedAt])
  @@map("bank_transactions")
}

/// Mês conferido e fechado.
///
/// A trava é pelo **vencimento** do lançamento, não pela data em que alguém
/// digitou: fechar março diz "março está conferido", e um lançamento novo com
/// vencimento em março mudaria o resultado de um mês já fechado. Um trigger
/// repete a regra no banco, como no contrato emitido.
model FinancialPeriod {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  year         Int
  month        Int       @db.SmallInt
  closedAt     DateTime  @default(now()) @map("closed_at") @db.Timestamptz()
  closedBy     String?   @map("closed_by") @db.Uuid
  reopenedAt   DateTime? @map("reopened_at") @db.Timestamptz()
  reopenReason String?   @map("reopen_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  autor  User?  @relation(fields: [closedBy], references: [id])

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@map("financial_periods")
}
