{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm exec turbo run build --filter=@autoconnect/web"
  },
  "deploy": {
    "startCommand": "pnpm --filter @autoconnect/web start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
